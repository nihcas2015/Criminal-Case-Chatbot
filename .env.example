# Backend Configuration Template
# Copy this file to .env and customize values as needed

# ============================================
# OLLAMA LLM Configuration
# ============================================

# Model to use (mistral, neural-chat, etc.)
# Default: mistral
# Options: mistral, neural-chat, orca-mini, llama2, etc.
OLLAMA_MODEL=mistral

# Ollama server host and port
# Default: http://127.0.0.1:11434
OLLAMA_HOST=http://127.0.0.1:11434

# Request timeout in seconds (for long responses)
# Default: 600 (10 minutes)
# Increase if model is slow, decrease if timeout too often
OLLAMA_TIMEOUT=600

# ============================================
# API Server Configuration
# ============================================

# Server host (0.0.0.0 for all interfaces, 127.0.0.1 for localhost only)
# Default: 0.0.0.0
API_HOST=0.0.0.0

# Server port number
# Default: 8000
API_PORT=8000

# Debug mode (True/False)
# Default: False
DEBUG=False

# ============================================
# Internet Access Configuration (Optional)
# ============================================

# Enable public URL (requires ngrok)
# Set to True to enable internet access
# PUBLIC_URL_ENABLED=False

# Ngrok authentication token (required if PUBLIC_URL_ENABLED=True)
# Get from: https://ngrok.com/auth
# NGROK_AUTHTOKEN=your_token_here

# ============================================
# Example Configurations
# ============================================

# For LOCAL DEVELOPMENT:
# OLLAMA_MODEL=mistral
# OLLAMA_HOST=http://127.0.0.1:11434
# API_HOST=127.0.0.1
# DEBUG=True

# For PRODUCTION:
# OLLAMA_MODEL=mistral
# OLLAMA_HOST=http://ollama-server:11434
# API_HOST=0.0.0.0
# DEBUG=False

# For INTERNET ACCESS (via ngrok):
# PUBLIC_URL_ENABLED=True
# NGROK_AUTHTOKEN=your_actual_token
# OLLAMA_MODEL=mistral
